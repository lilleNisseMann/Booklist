# Copy this file to .env and fill in your own values.

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bookshelf

# Port the website runs on (http://localhost:3001)
PORT=3001

# First admin account (only used when no admin exists yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Set to true when the site is served over https
COOKIE_SECURE=false
